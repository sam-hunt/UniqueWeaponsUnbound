<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

  <!-- EN: unique smithing -->
  <UniqueSmithing.label>forge d'armes uniques</UniqueSmithing.label>
  <!-- Vanilla fr research descriptions open with "Vous permet de..." / "Vous apprend
       à...". FueledSmithy/ElectricSmithy are "établi de forgeron", not "forge" —
       the building and the research use different words in fr. -->
  <!-- EN: Upgrade and customize neolithic and medieval weapons at a smithy, adding or removing traits to suit your needs. -->
  <UniqueSmithing.description>Vous permet d'améliorer et de personnaliser les armes néolithiques et médiévales sur un établi de forgeron, en ajoutant ou en retirant des traits selon vos besoins.</UniqueSmithing.description>

  <!-- EN: Customize neolithic weapons -->
  <UniqueSmithing.customUnlockTexts.0>Personnaliser les armes néolithiques</UniqueSmithing.customUnlockTexts.0>
  <!-- EN: Customize medieval weapons -->
  <UniqueSmithing.customUnlockTexts.1>Personnaliser les armes médiévales</UniqueSmithing.customUnlockTexts.1>

  <!-- Vanilla fr keeps the English symbol set but BAKES THE DEFINITE ARTICLE into
       subject and subject_gerund (Smithing: "le forgeage", Machining: "l'usinage",
       AdvancedFabrication: "la fabrication de composants avancés"). This is fr's
       answer to the problem es solved by adding a subject_def symbol. The consumer
       is live here, unlike in es: fr's translated Core RulePacks_Book_Descriptions
       writes "sur [subject]" and "pour [subject_primary_gerund]" with no article of
       its own, so an unarticled subject would render ungrammatically.
       Note fr subject_gerund is an articled noun phrase, not a gerund (vanilla:
       "le forgeage"), and subject_story is a subject-less passé composé clause. -->
  <!-- EN:
    <li>subject->unique smithing</li>
    <li>subject_story->learned to modify unique weapons by studying their traits</li>
    <li>subject_story->experimented with ancient weapon enhancements</li>
    <li>subject_gerund->smithing unique weapons</li>
  -->
  <UniqueSmithing.generalRules.rulesStrings>
    <li>subject->le forgeage d'armes uniques</li>
    <li>subject_story->a appris à modifier les armes uniques en étudiant leurs traits</li>
    <li>subject_story->a expérimenté d'anciennes améliorations d'armes</li>
    <li>subject_gerund->le forgeage d'armes uniques</li>
  </UniqueSmithing.generalRules.rulesStrings>

</LanguageData>
