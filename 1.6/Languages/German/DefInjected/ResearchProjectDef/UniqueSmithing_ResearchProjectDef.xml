<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

  <!-- EN: unique smithing -->
  <UniqueSmithing.label>Schmieden einzigartiger Waffen</UniqueSmithing.label>
  <!-- EN: Upgrade and customize neolithic and medieval weapons at a smithy, adding or removing traits to suit your needs. -->
  <UniqueSmithing.description>Werte neolithische und mittelalterliche Waffen an einer Schmiede auf und passe sie an, indem du Merkmale nach Bedarf hinzufügst oder entfernst.</UniqueSmithing.description>

  <!-- EN: Customize neolithic weapons -->
  <UniqueSmithing.customUnlockTexts.0>Neolithische Waffen anpassen</UniqueSmithing.customUnlockTexts.0>
  <!-- EN: Customize medieval weapons -->
  <UniqueSmithing.customUnlockTexts.1>Mittelalterliche Waffen anpassen</UniqueSmithing.customUnlockTexts.1>

  <!-- German research subjects carry a case paradigm (see vanilla Smithing/Machining/
       Fabrication). Head noun Schmiedekunst is feminine; the "für einzigartige Waffen"
       tail is invariant, so only the article and noun inflect. -->
  <!-- EN:
    <li>subject->unique smithing</li>
    <li>subject_story->learned to modify unique weapons by studying their traits</li>
    <li>subject_story->experimented with ancient weapon enhancements</li>
    <li>subject_gerund->smithing unique weapons</li>
  -->
  <UniqueSmithing.generalRules.rulesStrings>
    <li>subject_story->durch das Studium ihrer Merkmale lernte, einzigartige Waffen umzuarbeiten</li>
    <li>subject_story->mit Verbesserungen an antiken Waffen experimentierte</li>
    <li>subject_gerund->das Schmieden einzigartiger Waffen</li>
    <li>subject_gerund_with_of->des Schmiedens einzigartiger Waffen</li>
    <li>subject_gerund_with_to->zum Schmieden einzigartiger Waffen</li>
    <li>subject_gerund_acc->das Schmieden einzigartiger Waffen</li>
    <li>subject_gerund_dat->dem Schmieden einzigartiger Waffen</li>
    <!-- nominative indefinite zero article -->
    <li>subject->Schmiedekunst für einzigartige Waffen</li>
    <!-- gender nominative indefinite -->
    <li>subject_gender_nom_indef->|F|Schmiedekunst für einzigartige Waffen</li>
    <!-- of + genitive definite -->
    <li>subject_with_of->der Schmiedekunst für einzigartige Waffen</li>
    <!-- of + adj + genitive definite -->
    <li>subject_with_of_and_adj->der |adj|en Schmiedekunst für einzigartige Waffen</li>
    <!-- to + dative definite -->
    <li>subject_with_to->zur Schmiedekunst für einzigartige Waffen</li>
    <!-- to + adj + dative definite -->
    <li>subject_with_to_and_adj->zur |adj|en Schmiedekunst für einzigartige Waffen</li>
    <!-- the + dative definite -->
    <li>subject_with_the_dat->der Schmiedekunst für einzigartige Waffen</li>
    <!-- the + adj + dative definite -->
    <li>subject_with_the_and_adj_dat->der |adj|en Schmiedekunst für einzigartige Waffen</li>
    <!-- the + accusative definite -->
    <li>subject_with_the_acc->die Schmiedekunst für einzigartige Waffen</li>
    <!-- the + adj + accusative definite -->
    <li>subject_with_the_and_adj_acc->die |adj|e Schmiedekunst für einzigartige Waffen</li>
    <!-- dative indefinite zero article -->
    <li>subject_dat_indef_zero->Schmiedekunst für einzigartige Waffen</li>
    <!-- accusative indefinite zero article -->
    <li>subject_acc_indef_zero->Schmiedekunst für einzigartige Waffen</li>
  </UniqueSmithing.generalRules.rulesStrings>

</LanguageData>
