<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

  <!-- EN: unique machining -->
  <UniqueMachining.label>Maschinenbau einzigartiger Waffen</UniqueMachining.label>
  <!-- EN: Upgrade and customize industrial-era weapons at a machining table, adding or removing traits to suit your needs. -->
  <UniqueMachining.description>Werte Waffen des Industriezeitalters an einer Werkbank auf und passe sie an, indem du Merkmale nach Bedarf hinzufügst oder entfernst.</UniqueMachining.description>

  <!-- EN: Upgrade and customize industrial unique weapons -->
  <UniqueMachining.customUnlockTexts.0>Einzigartige Waffen des Industriezeitalters aufwerten und anpassen</UniqueMachining.customUnlockTexts.0>

  <!-- German research subjects carry a case paradigm (see vanilla Smithing/Machining/
       Fabrication). Head noun Maschinenbau is masculine; the "für einzigartige Waffen"
       tail is invariant, so only the article and noun inflect. -->
  <!-- EN:
    <li>subject->unique machining</li>
    <li>subject_story->reverse-engineered unique weapon modifications using industrial tools</li>
    <li>subject_story->perfected the art of applying weapon traits with precision machinery</li>
    <li>subject_gerund->machining unique weapons</li>
  -->
  <UniqueMachining.generalRules.rulesStrings>
    <li>subject_story->mit industriellen Werkzeugen die Umarbeitung einzigartiger Waffen nachkonstruierte</li>
    <li>subject_story->die Kunst perfektionierte, Waffenmerkmale mit Präzisionsmaschinen aufzubringen</li>
    <li>subject_gerund->die maschinelle Bearbeitung einzigartiger Waffen</li>
    <li>subject_gerund_with_of->der maschinellen Bearbeitung einzigartiger Waffen</li>
    <li>subject_gerund_with_to->zur maschinellen Bearbeitung einzigartiger Waffen</li>
    <li>subject_gerund_acc->die maschinelle Bearbeitung einzigartiger Waffen</li>
    <li>subject_gerund_dat->der maschinellen Bearbeitung einzigartiger Waffen</li>
    <!-- nominative indefinite zero article -->
