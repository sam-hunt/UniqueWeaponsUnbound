<LanguageData>

  <!-- EN: unique smithing -->
  <UniqueSmithing.label>herrería de armas únicas</UniqueSmithing.label>
  <!-- EN: Upgrade and customize neolithic and medieval weapons at a smithy, adding or removing traits to suit your needs. -->
  <UniqueSmithing.description>Mejora y personaliza armas neolíticas y medievales en una forja, añadiendo o quitando rasgos según tus necesidades.</UniqueSmithing.description>

  <!-- EN: Customize neolithic weapons -->
  <UniqueSmithing.customUnlockTexts.0>Personalizar armas neolíticas</UniqueSmithing.customUnlockTexts.0>
  <!-- EN: Customize medieval weapons -->
  <UniqueSmithing.customUnlockTexts.1>Personalizar armas medievales</UniqueSmithing.customUnlockTexts.1>

  <!-- Vanilla es adds a symbol English never defines: subject_def, the "of the X" form
       ("de la herrería", "del maquinado"). All 90 vanilla es research entries carry it, so
       ours do too. Note es subject_gerund is an INFINITIVE, not a gerund (vanilla: "forjar"),
       and subject_story is third-person preterite. -->
  <!-- EN:
    <li>subject->unique smithing</li>
    <li>subject_story->learned to modify unique weapons by studying their traits</li>
    <li>subject_story->experimented with ancient weapon enhancements</li>
    <li>subject_gerund->smithing unique weapons</li>
  -->
  <UniqueSmithing.generalRules.rulesStrings>
    <li>subject->herrería de armas únicas</li>
    <li>subject_def->de la herrería de armas únicas</li>
    <li>subject_story->aprendió a modificar armas únicas estudiando sus rasgos</li>
    <li>subject_story->experimentó con mejoras de armas antiguas</li>
    <li>subject_gerund->forjar armas únicas</li>
  </UniqueSmithing.generalRules.rulesStrings>

</LanguageData>
