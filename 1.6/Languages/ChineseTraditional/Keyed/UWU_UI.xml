  <!-- EN: Require weapon crafting research -->
  <UWU_RequireRecipeResearch>需要武器製作研究</UWU_RequireRecipeResearch>
  <!-- EN: When enabled, a weapon can only be customized once the research needed to craft it is complete. For example, customizing a {0} will require {1}. Default: {2}. -->
