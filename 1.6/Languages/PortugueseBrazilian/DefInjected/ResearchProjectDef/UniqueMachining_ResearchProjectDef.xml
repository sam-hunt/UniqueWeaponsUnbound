<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

  <!-- EN: unique machining -->
  <UniqueMachining.label>usinagem de armas únicas</UniqueMachining.label>
  <!-- pt-BR is consistent for this tier, unlike fr: the Machining research is
       "usinagem" and TableMachining is "mesa de usinagem". (AncientTableMachining
       = "Bancada de Mecanica Ancestral" is the ruin variant only.) -->
  <!-- EN: Upgrade and customize industrial-era weapons at a machining table, adding or removing traits to suit your needs. -->
  <UniqueMachining.description>Melhore e personalize armas da era industrial em uma mesa de usinagem, adicionando ou removendo características conforme suas necessidades.</UniqueMachining.description>

  <!-- EN: Upgrade and customize industrial unique weapons -->
  <UniqueMachining.customUnlockTexts.0>Melhore e personalize armas únicas industriais</UniqueMachining.customUnlockTexts.0>

  <!-- Bare, unarticled subject with a real gerund, matching vanilla pt-BR Machining
       ("subject->usinagem", "subject_gerund->construindo equipamento de usinagem",
       "usinando peças"). See UniqueSmithing_ResearchProjectDef.xml for why pt-BR
       needs no paradigm here. -->
  <!-- EN:
    <li>subject->unique machining</li>
    <li>subject_story->reverse-engineered unique weapon modifications using industrial tools</li>
    <li>subject_story->perfected the art of applying weapon traits with precision machinery</li>
    <li>subject_gerund->machining unique weapons</li>
  -->
  <UniqueMachining.generalRules.rulesStrings>
    <li>subject->usinagem de armas únicas</li>
    <li>subject_story->desvendou as modificações de armas únicas usando ferramentas industriais</li>
    <li>subject_story->dominou a arte de aplicar características de armas com máquinas de precisão</li>
    <li>subject_gerund->usinando armas únicas</li>
  </UniqueMachining.generalRules.rulesStrings>

</LanguageData>
