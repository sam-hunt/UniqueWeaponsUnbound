<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Tests are pure-data: they synthesize HaulPlanRequest inputs and call
         IHaulPlanner.Plan. No live RimWorld game context, no maps, no Find.*. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- ===== Where the game's 1.6 runtime assemblies come from =====
       The post-build copy step below needs the game's real runtime DLLs, not
       Krafs's ref/ stubs: those are stamped [assembly: ReferenceAssembly] and the
       CLR throws BadImageFormatException when the JIT resolves types from them at
       test execution time. Resolution order:
         1. RIMWORLD_MANAGED_1_6 (or -p:RimWorldManagedPath=...): an explicit folder.
         2. The install's <Data>/Managed/ folder, which only exists while the
            installed game is 1.6. Since RimWorld 1.7 (Waylith, .NET 10) the install
            is flat, ships no 1.6 assemblies, and its own Assembly-CSharp.dll is a
            net10 assembly this net472 test host cannot load.
         3. A frozen copy of the final 1.6 build's Managed/ files at
            ~/.local/share/RimWorld-1.6/Managed (see its README.txt), kept outside
            any repo so a 1.7 install, a git clean or a fresh clone cannot lose it.
       Any 1.6 install's Managed/ folder is a valid source for that copy.
       RimWorldPath mirrors the main csproj's defaults; here it only feeds step 2. -->
  <PropertyGroup>
    <RimWorldPath Condition="'$(RimWorldPath)' == ''">$(RIMWORLD_PATH)</RimWorldPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RimWorldPath)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">
    <RimWorldPath>C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RimWorldPath)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">
    <RimWorldPath>$(HOME)/.local/share/Steam/steamapps/common/RimWorld</RimWorldPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RimWorldPath)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">
    <RimWorldPath>$(HOME)/Library/Application Support/Steam/steamapps/common/RimWorld</RimWorldPath>
  </PropertyGroup>
  <PropertyGroup>
    <RimWorldManagedPath Condition="'$(RimWorldManagedPath)' == ''">$(RIMWORLD_MANAGED_1_6)</RimWorldManagedPath>
    <RimWorldManagedPath Condition="'$(RimWorldManagedPath)' == '' And Exists('$(RimWorldPath)/RimWorldWin64_Data/Managed/Assembly-CSharp.dll')">$(RimWorldPath)/RimWorldWin64_Data/Managed</RimWorldManagedPath>
    <RimWorldManagedPath Condition="'$(RimWorldManagedPath)' == '' And Exists('$(RimWorldPath)/RimWorldLinux_Data/Managed/Assembly-CSharp.dll')">$(RimWorldPath)/RimWorldLinux_Data/Managed</RimWorldManagedPath>
    <RimWorldManagedPath Condition="'$(RimWorldManagedPath)' == '' And Exists('$(RimWorldPath)/RimWorldMac_Data/Managed/Assembly-CSharp.dll')">$(RimWorldPath)/RimWorldMac_Data/Managed</RimWorldManagedPath>
    <RimWorldManagedPath Condition="'$(RimWorldManagedPath)' == '' And Exists('$(HOME)/.local/share/RimWorld-1.6/Managed/Assembly-CSharp.dll')">$(HOME)/.local/share/RimWorld-1.6/Managed</RimWorldManagedPath>
    <RimWorldManagedPath Condition="'$(RimWorldManagedPath)' == '' And Exists('$(USERPROFILE)/.local/share/RimWorld-1.6/Managed/Assembly-CSharp.dll')">$(USERPROFILE)/.local/share/RimWorld-1.6/Managed</RimWorldManagedPath>
    <UseRuntimeAssemblies Condition="'$(RimWorldManagedPath)' != '' And Exists('$(RimWorldManagedPath)/Assembly-CSharp.dll')">true</UseRuntimeAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- GeneratePathProperty exposes $(PkgKrafs_Rimworld_Ref) so the
         post-build target below can locate the package's ref/ folder as
         a CI fallback when no runtime assembly source is found. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" GeneratePathProperty="true" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- xunit.runner.console is a fallback standalone runner. The everyday
         path is plain `dotnet test`: on Linux/WSL vstest hosts the net472
         suite via mono automatically. The console runner remains useful for
         running the built test DLL directly under mono (bypassing vstest)
         when diagnosing host-level problems. -->
    <PackageReference Include="xunit.runner.console" Version="2.9.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Source\1.6\UniqueWeaponsUnbound.csproj" />
  </ItemGroup>

  <!-- The trait-cost pipeline tests run against the rule set that actually
       ships, parsed straight out of the def XML, so they can't drift from it.
       Copied beside the test assembly because test execution happens from a
       mirrored bin directory with no access to the repo tree. -->
  <ItemGroup>
    <None Include="..\..\1.6\Defs\TraitCostRuleDefs\TraitCostRules.xml"
          Link="TraitCostRules.xml"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- The labelKeywords whole-list injections, for the localization coverage
         tests. Linked under Languages\ mirroring the repo layout (%(RecursiveDir)
         is the <lang>\DefInjected\... tail), so a test asks for a language by
         name and a newly translated language needs no csproj edit. -->
    <None Include="..\..\1.6\Languages\**\DefInjected\UniqueWeaponsUnbound.TraitCostRuleDef\TraitCostRules_TraitCostRuleDef.xml"
          Link="Languages\%(RecursiveDir)TraitCostRules_TraitCostRuleDef.xml"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Copy RimWorld runtime assemblies into the test output so the test
       runner can resolve Verse.* / RimWorld.* / UnityEngine.* types at JIT
       time. Prefer real runtime DLLs from $(RimWorldManagedPath) (resolved
       above); fall back to Krafs's ref/ folder only when none are found.
       The Krafs fallback is non-functional at runtime — its DLLs are
       reference-only — but keeps `dotnet build` green on CI without an
       install present. Tests can't actually run in that mode, and a run in
       that mode overwrites any real DLLs a previous build had copied here. -->
  <Target Name="CopyRimWorldAssembliesToTestOutput" AfterTargets="Build">
    <ItemGroup Condition="'$(UseRuntimeAssemblies)' == 'true'">
      <_RimWorldAssemblies Include="$(RimWorldManagedPath)/Assembly-CSharp.dll" />
      <!-- Mono (the native WSL/Linux test host) resolves field types eagerly, so
           loading Verse.Current pulls in Assembly-CSharp-firstpass (its
           colorCorrectionCurvesInt field's type lives there). The Windows CLR
           resolves lazily and never needs it — omitting this DLL is invisible on
           Windows but fails ~61 tests under mono with BadImageFormatException. -->
      <_RimWorldAssemblies Include="$(RimWorldManagedPath)/Assembly-CSharp-firstpass.dll" />
      <_RimWorldAssemblies Include="$(RimWorldManagedPath)/UnityEngine*.dll" />
      <!-- Unity.Burst and friends: assembly-level attributes on Assembly-CSharp
           reference them, so anything that reflects over the assembly's
           attributes (xunit does, when serializing a RimWorld enum used as a
           [InlineData] argument) loads them. The ref-only copies throw
           BadImageFormatException there and break test discovery. -->
      <_RimWorldAssemblies Include="$(RimWorldManagedPath)/Unity.*.dll" />
      <!-- Assembly-CSharp's manifest refs netstandard 2.1 — RimWorld ships
           those facades from its bundled Mono runtime. The default test
           output picks up Microsoft.NETFramework.ReferenceAssemblies'
           ref-only stubs which fail strong-name verification at runtime.
           Copying RimWorld's runtime versions over the top fixes that. -->
      <_RimWorldAssemblies Include="$(RimWorldManagedPath)/netstandard.dll" />
      <_RimWorldAssemblies Include="$(RimWorldManagedPath)/System.Runtime.dll" />
      <!-- Steamworks for the same reason: RimWorld.Scenario implements
           WorkshopUploadable, so JITting anything that mentions Scenario (e.g.
           StatWorker.FinalizeValue, which every stat lookup goes through) makes
           the CLR load this assembly. Krafs's ref-only copy fails there with
           BadImageFormatException. -->
      <_RimWorldAssemblies Include="$(RimWorldManagedPath)/com.rlabrecque.steamworks.net.dll" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseRuntimeAssemblies)' != 'true'">
      <_RimWorldAssemblies Include="$(PkgKrafs_Rimworld_Ref)\ref\net472\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_RimWorldAssemblies)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
